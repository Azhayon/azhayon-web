# "production" turns on strict checks (https everywhere, keys required).
APP_ENV=local
# The Laravel API, called from the server. Production: https://api.azhayonmedia.com/api/v1
API_URL=http://127.0.0.1:8000/api/v1
# This site's public address, with no path. Production: https://azhayonmedia.com
SITE_URL=http://localhost:3000
# Keep false until real content is live: it makes every page noindex.
ALLOW_INDEXING=false
# Server-only secrets (never prefix with NEXT_PUBLIC_). They must equal the API's values.
FRONTEND_API_KEY=
REVALIDATE_SECRET=
# Used by the browser for search suggestions (public). Production: https://api.azhayonmedia.com/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1